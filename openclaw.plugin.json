{
  "id": "unifi",
  "name": "UniFi",
  "version": "0.2.3",
  "description": "Community tools for the official public UniFi APIs, including Cloud Connector and governed media.",
  "categories": [
    "infrastructure"
  ],
  "uiCapabilities": [
    "page",
    "navigation"
  ],
  "activation": {
    "onStartup": true
  },
  "skills": [
    "./skills"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "store"
              },
              {
                "type": "string",
                "const": "env"
              },
              {
                "type": "string",
                "const": "file"
              },
              {
                "type": "string",
                "const": "exec"
              }
            ]
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false,
        "description": "OpenClaw SecretRef only. Use the UniFi page to connect automatically, or configure an advanced SecretRef. Never paste a plaintext key here."
      },
      "setupBinding": {
        "type": "string",
        "pattern": "^OPENCLAW_UNIFI_[A-F0-9]{32}$",
        "description": "Automatic setup generation marker; not a credential. Written together with the protected token reference."
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 120000,
        "default": 30000,
        "description": "Whole request deadline, including response reading."
      },
      "maxResponseBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 10485760,
        "default": 10485760,
        "description": "Bounded JSON response bytes; Cloud Connector upstream also limits responses to 10 MB."
      }
    },
    "additionalProperties": false
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "UniFi API key reference",
      "sensitive": true,
      "advanced": true,
      "help": "Open UniFi in the sidebar for automatic token setup. This advanced field accepts external env/file/exec/store SecretRefs only."
    },
    "setupBinding": {
      "label": "Automatic connection generation",
      "advanced": true,
      "help": "Managed automatically by UniFi setup; do not edit."
    },
    "requestTimeoutMs": {
      "label": "Request timeout (milliseconds)",
      "advanced": true
    },
    "maxResponseBytes": {
      "label": "Maximum JSON response bytes",
      "advanced": true
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/f34d0727088987c34f0a5b37810ac7040884ac27deecba1610ac6a5e5e8de98c/index.js"
  },
  "doctorContract": {
    "configRepair": true,
    "stateMigrations": []
  },
  "contracts": {
    "tools": [
      "unifi_status",
      "unifi_discover",
      "unifi_describe",
      "unifi_request",
      "unifi_request_write"
    ]
  },
  "toolMetadata": {
    "unifi_status": {
      "replaySafe": true,
      "sideEffecting": false
    },
    "unifi_discover": {
      "replaySafe": true,
      "sideEffecting": false
    },
    "unifi_describe": {
      "replaySafe": true,
      "sideEffecting": false
    },
    "unifi_request": {
      "replaySafe": true,
      "sideEffecting": false
    },
    "unifi_request_write": {
      "replaySafe": false,
      "sideEffecting": true
    }
  }
}
